<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>NDA Wallah - YouTube Downloader</title>

  <link rel="stylesheet" href="style.css">
</head>

<body>

  <div class="container">

    <div class="card">

      <div class="logo">
        NDA <span>WALLAH</span>
      </div>

      <h1>YouTube Video Downloader</h1>

      <p class="subtitle">
        Paste a YouTube video link below
      </p>

      <form id="downloadForm">

        <input
          type="url"
          id="youtubeUrl"
          placeholder="Paste YouTube URL here..."
          required
        >

        <button type="submit" id="getVideoBtn">
          Get Video
        </button>

      </form>

      <div id="status"></div>

      <div id="videoResult" class="hidden"></div>

      <p class="warning">
        Use this tool only for videos you own or have permission to download.
      </p>

    </div>

  </div>

  <script src="script.js"></script>

</body>
</html>