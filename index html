<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>YouTube Video Downloader</title>
  <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}">
</head>
<body>
  <main class="card">
    <h1>YouTube Video Downloader</h1>
    <p class="sub">Paste a link, pick a format, download.</p>

    <div class="row">
      <input id="url" type="url" placeholder="https://www.youtube.com/watch?v=..." autocomplete="off">
      <button id="fetchBtn">Fetch</button>
    </div>

    <p id="msg" class="msg"></p>

    <section id="result" hidden>
      <img id="thumb" alt="Thumbnail">
      <h2 id="title"></h2>
      <p id="meta" class="sub"></p>

      <div class="row">
        <select id="kind">
          <option value="video">Video (MP4)</option>
          <option value="audio">Audio only (MP3)</option>
        </select>
        <select id="quality"></select>
      </div>
      <button id="dlBtn" class="primary">Download</button>
    </section>

    <p class="note">Only download content you own or have permission to save.</p>
  </main>
  <script src="{{ url_for('static', filename='app.js') }}"></script>
</body>
</html>
