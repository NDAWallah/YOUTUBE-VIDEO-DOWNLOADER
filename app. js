const $ = (id) => document.getElementById(id);
const msg = (t, ok = false) => { $("msg").textContent = t; $("msg").style.color = ok ? "#86efac" : ""; };

$("fetchBtn").addEventListener("click", async () => {
  msg(""); $("result").hidden = true;
  $("fetchBtn").disabled = true;
  try {
    const r = await fetch("/api/info", {
      method: "POST", headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ url: $("url").value }),
    });
    const d = await r.json();
    if (!r.ok) throw new Error(d.error);
    $("thumb").src = d.thumbnail || "";
    $("title").textContent = d.title;
    $("meta").textContent = [d.channel, d.duration].filter(Boolean).join(" • ");
    $("quality").innerHTML = (d.heights.length ? d.heights : [720])
      .map((h) => `<option value="${h}">${h}p</option>`).join("");
    $("result").hidden = false;
  } catch (e) { msg(e.message); }
  $("fetchBtn").disabled = false;
});

$("kind").addEventListener("change", () => {
  $("quality").style.display = $("kind").value === "audio" ? "none" : "";
});

$("dlBtn").addEventListener("click", async () => {
  $("dlBtn").disabled = true; msg("Downloading… this can take a moment.", true);
  try {
    const r = await fetch("/api/download", {
      method: "POST", headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ url: $("url").value, kind: $("kind").value, height: $("quality").value }),
    });
    if (!r.ok) throw new Error((await r.json()).error);
    const blob = await r.blob();
    const name = (r.headers.get("Content-Disposition") || "").match(/filename\*?=(?:UTF-8'')?"?([^";]+)/i);
    const a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = name ? decodeURIComponent(name[1]) : "video.mp4";
    a.click(); URL.revokeObjectURL(a.href);
    msg("Done!", true);
  } catch (e) { msg(e.message); }
  $("dlBtn").disabled = false;
});
