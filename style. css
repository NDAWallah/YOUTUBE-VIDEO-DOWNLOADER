* {
  box-sizing: border-box;
}

body {
  margin: 0;
  padding: 0;
  min-height: 100vh;

  font-family: Arial, sans-serif;

  background:
    linear-gradient(
      135deg,
      #050505,
      #111827,
      #050505
    );

  color: white;
}

.container {
  min-height: 100vh;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 20px;
}

.card {
  width: 100%;
  max-width: 650px;

  padding: 35px;

  background: rgba(20, 25, 40, 0.95);

  border: 1px solid #30394f;

  border-radius: 22px;

  box-shadow:
    0 20px 60px rgba(0, 0, 0, 0.6);
}

.logo {
  font-size: 22px;
  font-weight: 900;
  letter-spacing: 2px;
}

.logo span {
  color: #4da3ff;
}

h1 {
  margin-top: 30px;
  margin-bottom: 10px;

  font-size: 42px;
}

.subtitle {
  color: #aeb8ca;

  margin-bottom: 30px;
}

form {
  display: flex;
  gap: 10px;
}

input {
  flex: 1;

  padding: 16px;

  border-radius: 12px;

  border: 1px solid #3b465f;

  background: #0b1020;

  color: white;

  font-size: 16px;

  outline: none;
}

input:focus {
  border-color: #4da3ff;
}

button {
  padding: 16px 22px;

  border: none;

  border-radius: 12px;

  background: white;

  color: #111827;

  font-size: 15px;

  font-weight: bold;

  cursor: pointer;
}

button:hover {
  opacity: 0.9;
}

button:disabled {
  opacity: 0.5;

  cursor: wait;
}

#status {
  margin-top: 20px;

  min-height: 25px;

  color: #aeb8ca;
}

#videoResult {
  margin-top: 20px;

  padding: 20px;

  background: #0b1020;

  border-radius: 15px;
}

.hidden {
  display: none;
}

.warning {
  margin-top: 25px;

  color: #7f8aa0;

  font-size: 12px;
}

@media (max-width: 600px) {

  .card {
    padding: 25px;
  }

  h1 {
    font-size: 30px;
  }

  form {
    flex-direction: column;
  }

  button {
    width: 100%;
  }

}